// Verificar cuantos managers hay realmente en la BD
const mariadb = require('mariadb');

(async () => {
  const conn = await mariadb.createConnection({
    host: '127.0.0.1',
    port: 3306,
    user: 'root',
    password: 'Xvfv2du1p5xyZX',
    database: 'crm_jdl',
  });

  const totalEmpresas = await conn.query('SELECT COUNT(*) as total FROM empresas');
  console.log('Total empresas en BD:', totalEmpresas[0].total);

  const totalEncargados = await conn.query('SELECT COUNT(*) as total FROM encargados_empresa');
  console.log('Total encargados en BD:', totalEncargados[0].total);

  if (totalEncargados[0].total > 0) {
    const sample = await conn.query(`
      SELECT e.id as empresa_id, e.nombre, ee.id as encargado_id, ee.nombre as encargado_nombre
      FROM encargados_empresa ee
      JOIN empresas e ON e.id = ee.id_empresa
      LIMIT 10
    `);
    console.log('\nMuestra de encargados con sus empresas:');
    console.table(sample);
  }

  // Cuantas empresas tienen encargado_principal pero NO tienen managers
  const sinManagers = await conn.query(`
    SELECT COUNT(*) as total
    FROM empresas e
    WHERE (e.encargado_principal IS NOT NULL AND e.encargado_principal != '')
      AND NOT EXISTS (SELECT 1 FROM encargados_empresa ee WHERE ee.id_empresa = e.id)
  `);
  console.log('\nEmpresas con encargado_principal pero SIN managers en encargados_empresa:', sinManagers[0].total);

  // Cuantas empresas tienen managers
  const conManagers = await conn.query(`
    SELECT COUNT(*) as total
    FROM empresas e
    WHERE EXISTS (SELECT 1 FROM encargados_empresa ee WHERE ee.id_empresa = e.id)
  `);
  console.log('Empresas CON managers en encargados_empresa:', conManagers[0].total);

  await conn.end();
})().catch(e => { console.error('ERROR:', e.message); process.exit(1); });
