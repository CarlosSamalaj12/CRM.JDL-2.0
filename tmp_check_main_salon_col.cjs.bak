// Reutiliza el pool del servidor sin hacer listen
process.env.NODE_ENV = 'test';
const Module = require('module');
const orig = Module.prototype.require;
let pool;
Module.prototype.require = function (id) {
  const m = orig.apply(this, arguments);
  if (id === 'mariadb' && m && typeof m.createPool === 'function' && !pool) {
    pool = m;
  }
  return m;
};

const fs = require('fs');
const path = require('path');
const code = fs.readFileSync(path.join(__dirname, 'server.cjs'), 'utf8');
// Stub app.listen: reemplazar la llamada real
const stubbed = code.replace(/server\.listen\([^)]*\);/g, '/* stub */');
const Module2 = require('module');
const m = new Module2('server');
m.filename = path.join(__dirname, 'server.cjs');
m.paths = Module2._nodeModulePaths(__dirname);
m._compile(stubbed, m.filename);

(async () => {
  // Esperar a que las migraciones terminen
  await new Promise((r) => setTimeout(r, 3000));
  const mariadb = require('mariadb');
  // El pool real está dentro del server.cjs, no exportado. Reutilizamos el módulo cargado.
  const cols = await pool.query(
    "SELECT column_name, column_type, is_nullable FROM information_schema.columns WHERE table_schema = 'crm_jdl' AND table_name = 'eventos' AND column_name IN ('nombre_salon', 'salon_principal') ORDER BY ordinal_position"
  );
  console.log('Columnas en tabla eventos:');
  console.table(cols);

  const sample = await pool.query(
    "SELECT id, nombre, nombre_salon, salon_principal FROM eventos WHERE salon_principal IS NOT NULL ORDER BY id DESC LIMIT 5"
  );
  console.log('Eventos con salon_principal seteado:');
  console.table(sample);

  const count = await pool.query("SELECT COUNT(*) as total FROM eventos");
  console.log('Total eventos en BD:', count[0].total);

  process.exit(0);
})().catch((e) => { console.error(e.message); process.exit(1); });
