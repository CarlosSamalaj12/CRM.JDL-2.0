// Test: Crear una empresa con un manager y verificar si se guarda en BD
const mariadb = require('mariadb');
const fetch = (...args) => import('node-fetch').then(({default: fetch}) => fetch(...args));

const API = 'http://127.0.0.1:3000/api/state';

(async () => {
  console.log('=== TEST: Crear empresa con manager ===\n');

  // 1) Leer el state actual
  console.log('1) Leyendo state actual...');
  const res1 = await fetch(API);
  const current = await res1.json();
  const state = current.state;
  console.log(`   Empresas actuales: ${state.companies.length}`);

  // 2) Crear una empresa nueva con un manager
  console.log('\n2) Creando empresa de prueba con 1 manager...');
  const testId = 'test_mgr_' + Date.now();
  const testManagerId = 'test_mgr_staff_' + Date.now();
  const newCompany = {
    id: testId,
    name: 'TEST EMPRESA MANAGER',
    owner: 'TEST OWNER',
    email: 'test@empresa.com',
    nit: '1234567-8',
    businessName: 'TEST S.A.',
    eventType: 'Social',
    address: 'TEST ADDRESS',
    phone: '12345678',
    notes: '',
    managers: [
      {
        id: testManagerId,
        name: 'TEST MANAGER',
        phone: '87654321',
        email: 'manager@test.com',
        address: 'TEST MGR ADDRESS'
      }
    ]
  };
  const newState = {
    ...state,
    companies: [...state.companies, newCompany]
  };

  console.log(`   Empresa: ${newCompany.name}`);
  console.log(`   Manager: ${newCompany.managers[0].name}`);

  // 3) PUT /api/state
  console.log('\n3) PUT /api/state...');
  const putRes = await fetch(API, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ state: newState })
  });
  const putResult = await putRes.json();
  console.log(`   Status: ${putRes.status}`);
  console.log(`   Respuesta: ${JSON.stringify(putResult).slice(0, 150)}`);

  // 4) Verificar en BD
  console.log('\n4) Verificando en BD...');
  const conn = await mariadb.createConnection({
    host: '127.0.0.1', port: 3306, user: 'root', password: 'Xvfv2du1p5xyZX', database: 'crm_jdl'
  });

  const empresa = await conn.query('SELECT id, nombre, encargado_principal FROM empresas WHERE id = ?', [testId]);
  console.log(`   Empresa en BD: ${empresa.length > 0 ? 'SI' : 'NO'}`);
  if (empresa.length > 0) console.log('   Datos:', empresa[0]);

  const encargado = await conn.query('SELECT id, id_empresa, nombre, telefono, correo FROM encargados_empresa WHERE id_empresa = ?', [testId]);
  console.log(`   Encargado(s) en BD: ${encargado.length}`);
  if (encargado.length > 0) console.log('   Datos:', encargado[0]);
  else console.log('   ❌ BUG: La empresa se creó pero el encargado NO se guardó en encargados_empresa');

  // 5) Cleanup: eliminar la empresa de prueba
  console.log('\n5) Limpiando empresa de prueba...');
  await conn.query('DELETE FROM empresas WHERE id = ?', [testId]);

  // 6) Verificar el state después del cleanup
  const totalEncargados = await conn.query('SELECT COUNT(*) as total FROM encargados_empresa');
  console.log(`   Total encargados en BD ahora: ${totalEncargados[0].total}`);

  await conn.end();
  console.log('\n=== FIN DEL TEST ===');
})().catch(e => { console.error('ERROR:', e.message); process.exit(1); });
