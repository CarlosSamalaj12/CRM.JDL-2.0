// Test que simula el flujo de selección de empresa en QuoteModal.
// Reproduce applyCompanyManager y verifica que setea todos los campos.

const companies = [
  {
    id: 'cmp_001',
    name: 'Empresa Test',
    owner: 'Juan Dueño',
    email: 'empresa@test.com',
    nit: '1234567-8',
    businessName: 'Empresa Test S.A.',
    phone: '55555555',
    address: 'Calle 123',
    eventType: 'Social',
    managers: [
      {
        id: 'mgr_001',
        name: 'Carlos Encargado',
        phone: '77777777',
        email: 'carlos@test.com',
        address: 'Calle 123'
      }
    ]
  }
];

// Replica applyCompanyManager del QuoteModal
const applyCompanyManager = (quote, company, managerId) => {
  if (!company) return quote;
  const managers = Array.isArray(company.managers) ? company.managers : [];
  const manager = managers.find(m => String(m.id || '') === String(managerId || '')) || managers[0] || null;
  return {
    ...quote,
    companyId: company.id || quote.companyId,
    companyName: company.name || quote.companyName,
    contact: manager?.name || company.owner || '',
    email: manager?.email || company.email || '',
    phone: manager?.phone || company.phone || '',
    nit: company.nit || '',
    billTo: company.businessName || company.billTo || company.name || '',
    address: company.address || '',
    eventType: company.eventType || quote.eventType || 'Social',
    managerId: manager?.id || '',
    managerName: manager?.name || '',
  };
};

const initialQuote = {
  companyId: '',
  contact: '',
  email: '',
  phone: '',
  nit: '',
  billTo: '',
  address: '',
  managerId: '',
};

const c = companies[0];
const result = applyCompanyManager(initialQuote, c, c.managers[0].id);

console.log('--- Después de seleccionar empresa ---');
console.log({
  companyId: result.companyId,
  contact: result.contact,
  email: result.email,
  phone: result.phone,
  nit: result.nit,
  billTo: result.billTo,
  address: result.address,
  managerId: result.managerId,
});

console.log('\n--- Validación ---');
const missing = [];
if (!result.contact) missing.push('Contacto');
if (!result.managerId) missing.push('Encargado');
if (!result.email) missing.push('Email');
if (!result.phone) missing.push('Teléfono');
if (!result.nit) missing.push('NIT');
if (!result.billTo) missing.push('Facturar a');
if (!result.address) missing.push('Dirección');
console.log('Campos faltantes:', missing.length === 0 ? 'NINGUNO ✅' : missing);
