// Verificacion de consistencia: encargados_empresa vs empresas
const mariadb = require('mariadb');

(async () => {
  const conn = await mariadb.createConnection({
    host: '127.0.0.1',
    port: 3306,
    user: 'root',
    password: 'Xvfv2du1p5xyZX',
    database: 'crm_jdl',
  });

  console.log('=== VERIFICACION DE CONSISTENCIA: ENCARGADOS vs EMPRESAS ===\n');

  // 1) Conteos generales
  const totalEmpresas = await conn.query('SELECT COUNT(*) as total FROM empresas');
  const totalEncargados = await conn.query('SELECT COUNT(*) as total FROM encargados_empresa');
  console.log('1) Conteos generales:');
  console.log('   - Empresas en BD: ' + totalEmpresas[0].total);
  console.log('   - Encargados en BD: ' + totalEncargados[0].total);

  if (totalEncargados[0].total === 0) {
    console.log('\n   ⚠️  No hay encargados en la tabla. El bug del server los borro.');
    console.log('   Probablemente necesitas re-poblar desde la UI (ya esta el fix listo).');
  } else {
    // 2) Encargados huerfanos (id_empresa no existe en empresas)
    const huerfanos = await conn.query(`
      SELECT ee.id, ee.id_empresa, ee.nombre, ee.correo
      FROM encargados_empresa ee
      LEFT JOIN empresas e ON e.id = ee.id_empresa
      WHERE e.id IS NULL
    `);
    console.log('\n2) Encargados huerfanos (id_empresa NO existe en empresas): ' + huerfanos.length);
    if (huerfanos.length > 0) {
      console.log('   Primeros 10:');
      console.table(huerfanos.slice(0, 10));
    }

    // 3) Verificacion de formato del id (id debe ser VARCHAR no vacio)
    const idsVacios = await conn.query(`
      SELECT id, id_empresa, nombre FROM encargados_empresa
      WHERE id = '' OR id IS NULL OR id_empresa = '' OR id_empresa IS NULL
    `);
    console.log('\n3) Encargados con id o id_empresa vacios: ' + idsVacios.length);
    if (idsVacios.length > 0) {
      console.table(idsVacios.slice(0, 10));
    }

    // 4) Misma empresa + mismo nombre (posibles duplicados)
    const duplicados = await conn.query(`
      SELECT id_empresa, nombre, COUNT(*) as total
      FROM encargados_empresa
      GROUP BY id_empresa, nombre
      HAVING COUNT(*) > 1
    `);
    console.log('\n4) Duplicados (misma empresa + mismo nombre): ' + duplicados.length);
    if (duplicados.length > 0) {
      console.table(duplicados.slice(0, 10));
    }

    // 5) Encargados por empresa
    const porEmpresa = await conn.query(`
      SELECT id_empresa, COUNT(*) as total_encargados
      FROM encargados_empresa
      GROUP BY id_empresa
      ORDER BY total_encargados DESC
      LIMIT 10
    `);
    console.log('\n5) Top 10 empresas con mas encargados:');
    if (porEmpresa.length > 0) console.table(porEmpresa);
    else console.log('   (sin datos)');

    // 6) Resumen de integridad
    const totalOk = await conn.query(`
      SELECT COUNT(*) as total
      FROM encargados_empresa ee
      INNER JOIN empresas e ON e.id = ee.id_empresa
    `);
    console.log('\n6) Resumen de integridad:');
    console.log('   - Encargados con empresa padre valida: ' + totalOk[0].total);
    console.log('   - Encargados huerfanos: ' + huerfanos.length);
    console.log('   - Encargados con id vacio: ' + idsVacios.length);
  }

  // 7) Empresas con encargado_principal lleno pero SIN managers formales
  const conOwnerSinMgr = await conn.query(`
    SELECT id, nombre, encargado_principal
    FROM empresas
    WHERE encargado_principal IS NOT NULL
      AND encargado_principal != ''
      AND id NOT IN (SELECT DISTINCT id_empresa FROM encargados_empresa)
    ORDER BY id
  `);
  console.log('\n7) Empresas con "encargado_principal" (legacy) pero SIN managers formales: ' + conOwnerSinMgr.length);
  if (conOwnerSinMgr.length > 0) {
    console.log('   Primeras 10:');
    console.table(conOwnerSinMgr.slice(0, 10));
  }

  // 8) Empresas con managers formales
  const conMgr = await conn.query(`
    SELECT e.id, e.nombre, COUNT(ee.id) as total_managers
    FROM empresas e
    LEFT JOIN encargados_empresa ee ON ee.id_empresa = e.id
    GROUP BY e.id, e.nombre
    HAVING total_managers > 0
    ORDER BY e.id
    LIMIT 10
  `);
  console.log('\n8) Empresas CON managers formales (primeras 10): ' + conMgr.length);
  if (conMgr.length > 0) console.table(conMgr);

  // 9) Distribucion de managers por empresa
  const distribucion = await conn.query(`
    SELECT
      CASE
        WHEN total = 0 THEN '0 managers'
        WHEN total = 1 THEN '1 manager'
        WHEN total BETWEEN 2 AND 3 THEN '2-3 managers'
        ELSE '4+ managers'
      END as rango,
      COUNT(*) as total_empresas
    FROM (
      SELECT e.id, COUNT(ee.id) as total
      FROM empresas e
      LEFT JOIN encargados_empresa ee ON ee.id_empresa = e.id
      GROUP BY e.id
    ) as t
    GROUP BY rango
    ORDER BY rango
  `);
  console.log('\n9) Distribucion de managers por empresa:');
  console.table(distribucion);

  // 10) Verificacion de tipos de columnas
  const colsEncargados = await conn.query(`
    SELECT column_name, column_type, is_nullable
    FROM information_schema.columns
    WHERE table_schema = 'crm_jdl' AND table_name = 'encargados_empresa'
    ORDER BY ordinal_position
  `);
  console.log('\n10) Estructura de la tabla encargados_empresa:');
  console.table(colsEncargados);

  const colsEmpresas = await conn.query(`
    SELECT column_name, column_type, is_nullable
    FROM information_schema.columns
    WHERE table_schema = 'crm_jdl' AND table_name = 'empresas'
    ORDER BY ordinal_position
  `);
  console.log('\n11) Estructura de la tabla empresas:');
  console.table(colsEmpresas);

  await conn.end();
  console.log('\n=== FIN DE LA VERIFICACION ===');
})().catch(e => { console.error('ERROR:', e.message); process.exit(1); });
